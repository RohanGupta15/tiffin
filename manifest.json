{
	"manifest_version": 3,
	"name": "Tiffin",
	"version": "2.0.0",
	"description": "Bento, one tier up: a typographic new tab and home page.",
	"icons": {
		"64": "assets/icons/tiffin.svg"
	},
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"chrome_settings_overrides": {
		"homepage": "index.html"
	},
	"permissions": [
		"geolocation",
		"search"
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "tiffin@rohangupta15",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": [
					"locationInfo"
				]
			}
		}
	}
}
